              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/adjudicate": {
      "post": {
        "summary": "Adjudicate",
        "description": "Adjudicate one event and optionally persist evidence + case.",
        "operationId": "adjudicate_adjudicate_post",
