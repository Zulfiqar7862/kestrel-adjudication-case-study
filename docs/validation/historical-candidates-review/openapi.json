  "components": {
    "schemas": {
      "CaseState": {
        "type": "string",
        "enum": [
          "NEW",
          "TRIAGED_NON_ACTIONABLE",
          "PENDING_EVIDENCE",
          "RECOMMENDED",
          "AWAITING_REVIEWER",
          "RETURNED_FOR_DATA",
          "PENDING_LAB",
          "PENDING_SECOND_SIGN",
          "CLOSED_AUTO",
          "CLOSED_SIGNED",
          "REOPENED"
        ],
        "title": "CaseState",
        "description": "Case lifecycle states from NEW through CLOSED_* and REOPENED."
      },
      "Disposition": {
        "type": "string",
        "enum": [
          "AUTO_CLOSE",
          "HISTORICAL_CLOSURE_CANDIDATE_UNVERIFIED",
          "RELEASE",
          "RELEASE_WITH_NOTE",
          "QUARANTINE_PENDING_LAB",
          "DESTROY",
          "RETURN_TO_ORIGIN",
          "REWORK_RELABEL",
          "ESCALATED_TO_SENIOR_QA"
        ],
        "title": "Disposition",
        "description": "Allowed disposition / recommendation values for an excursion case."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "_AdjudicateRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "title": "Event Id"
          },
          "persist": {
            "type": "boolean",
            "title": "Persist",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "event_id"
        ],
        "title": "_AdjudicateRequest",
        "description": "POST /adjudicate body."
      },
      "_AdjudicateResponse": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "tenant_code": {
            "type": "string",
            "title": "Tenant Code"
          },
          "recommendation": {
            "$ref": "#/components/schemas/Disposition"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "triage_label": {
            "type": "string",
            "title": "Triage Label"
          },
          "case_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseState"
              },
              {
                "type": "null"
              }
            ]
          },
          "requires_human_signature": {
            "type": "boolean",
            "title": "Requires Human Signature"
          },
          "requires_human_review": {
            "type": "boolean",
            "title": "Requires Human Review"
          },
          "historical_classification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Historical Classification",
            "description": "Unverified historical reference, not independent evidence"
          },
          "closure_eligibility": {
            "type": "string",
            "enum": [
              "not_eligible",
              "historical_candidate_unverified",
              "rule_supported_unverified"
            ],
            "title": "Closure Eligibility"
          },
          "independent_closure_evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Independent Closure Evidence",
            "description": "Independent verification artifacts; empty in supplied pack"
          },
          "rationale": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rationale"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "event_id",
          "tenant_code",
          "recommendation",
          "confidence",
          "triage_label",
          "requires_human_signature",
          "requires_human_review",
          "historical_classification",
          "closure_eligibility",
          "independent_closure_evidence"
        ],
        "title": "_AdjudicateResponse",
        "description": "Recommendation is not a verification claim; historical candidates need review."
      },
      "_BasisRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "title": "Event Id"
          },
          "tenant_code": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Code"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "tenant_code"
        ],
        "title": "_BasisRequest",
        "description": "POST /evidence/basis body."
      },
      "_ClosureCounts": {
        "properties": {
          "verified_auto_close": {
            "type": "integer",
            "title": "Verified Auto Close"
          },
          "historical_candidates_unverified": {
            "type": "integer",
            "title": "Historical Candidates Unverified"
          },
          "other_auto_close_unverified": {
            "type": "integer",
            "title": "Other Auto Close Unverified"
          }
        },
        "type": "object",
        "required": [
          "verified_auto_close",
          "historical_candidates_unverified",
          "other_auto_close_unverified"
        ],
        "title": "_ClosureCounts"
      },
      "_EventsResponse": {
        "properties": {
          "closure_counts": {
            "$ref": "#/components/schemas/_ClosureCounts"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/_AdjudicateResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "closure_counts",
          "count",
          "counts",
          "items"
        ],
        "title": "_EventsResponse"
      },
      "_HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "rule_pack_version": {
            "type": "string",
            "title": "Rule Pack Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "rule_pack_version"
        ],
        "title": "_HealthResponse",
        "description": "GET /health payload."
      },
      "_MetricsResponse": {
        "properties": {
          "closure_counts": {
            "$ref": "#/components/schemas/_ClosureCounts"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "closure_counts"
        ],
        "title": "_MetricsResponse"
      },
      "_ReplayRequest": {
        "properties": {
          "bundle_id": {
            "type": "string",
            "minLength": 1,
            "title": "Bundle Id"
          },
          "tenant_code": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Code"
          }
        },
        "type": "object",
        "required": [
          "bundle_id",
          "tenant_code"
        ],
        "title": "_ReplayRequest",
        "description": "POST /replay body."
      },
      "_VerifyRequest": {
        "properties": {
          "tenant_code": {
            "type": "string",
