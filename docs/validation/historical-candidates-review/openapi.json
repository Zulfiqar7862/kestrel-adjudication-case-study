          {
            "name": "tenant_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tenant Code"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "YYYY-MM-DD",
              "title": "Date"
            },
            "description": "YYYY-MM-DD"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
