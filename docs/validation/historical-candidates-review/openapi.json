    "/events/{event_id}": {
      "get": {
        "summary": "Event Detail",
        "description": "Read-only adjudication of one event: facts, uncertainty scenarios, as-of basis and rule trace.",
        "operationId": "event_detail_events__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
