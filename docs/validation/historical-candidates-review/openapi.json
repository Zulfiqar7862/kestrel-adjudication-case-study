{
  "openapi": "3.1.0",
  "info": {
    "title": "Kestrel Sentinel Adjudication API",
    "description": "As-of adjudication, evidence basis, shadow replay, queue.",
    "version": "0.4.3"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness + rule-pack identity.",
        "operationId": "health_health_get",
